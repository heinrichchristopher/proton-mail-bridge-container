<?xml version="1.0"?>
<Container version="2">
  <Name>proton-mail-bridge</Name>
  <Repository>ghcr.io/heinrichchristopher/proton-mail-bridge:latest</Repository>
  <Registry>https://github.com/heinrichchristopher/proton-mail-bridge-container/pkgs/container/proton-mail-bridge</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/heinrichchristopher/proton-mail-bridge-container/issues</Support>
  <Overview>Proton Mail Bridge, lauscht auf 0.0.0.0 (SMTP 2025, IMAP 2143). Erst-Login siehe README.</Overview>
  <Category>Network:Other</Category>
  <Config Name="SMTP" Target="2025" Default="2025" Mode="tcp" Description="SMTP" Type="Port" Display="always" Required="true">2025</Config>
  <Config Name="IMAP" Target="2143" Default="2143" Mode="tcp" Description="IMAP" Type="Port" Display="always" Required="true">2143</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/proton-mail-bridge" Mode="rw" Description="Konfiguration, Login, Keys" Type="Path" Display="always" Required="true">/mnt/user/appdata/proton-mail-bridge</Config>
</Container>
